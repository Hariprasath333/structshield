# ==============================================================================
# StructShield Environment Configuration Example
# Copy this file to .env for local overrides (never commit .env)
# ==============================================================================

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/structshield
SPRING_DATASOURCE_USERNAME=structshield_user
SPRING_DATASOURCE_PASSWORD=structshield_secure_pass

# Messaging (Apache Kafka)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_FLAGS=flags

# Cache & Window State (Redis)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS & Web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Detection Engine Configurations
STRUCTURING_THRESHOLD=2000.00
MIN_CLUSTER_SIZE=3
ROLLING_WINDOW_MINUTES=5
NEAR_CEILING_AMOUNT=1800.00
RISK_THRESHOLD=70.00
ROUNDING_UNIT=500.00

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
